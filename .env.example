# ==============================================================================
# AI Teacher Platform Environment Configuration (Template)
# Copy this file to .env and fill in your credentials
# ==============================================================================

# Database Configuration
DATABASE_URL=sqlite:///./ai_teacher.db

# JWT & Authentication Configurations
# WARNING: Change this key to a secure random 32-byte hex string!
JWT_SECRET_KEY=696b4bf2826cfc2db724b0ad4b8efc0f4f98df363725b8216c52a0a2df37b420
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# System prompt applied to all LLM requests
SYSTEM_PROMPT="You are a helpful AI Teacher assisting a student with their curriculum."

# ------------------------------------------------------------------------------
# LLM Providers Configuration
# ------------------------------------------------------------------------------

# Primary LLM Selection
# Supported options: groq, ollama
PRIMARY_LLM=groq

# LLM Generation Parameters
TEMPERATURE=0.7
MAX_TOKENS=512

# Groq Cloud Configuration (Primary)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (Fallback/Secondary)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL=llama3
